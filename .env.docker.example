# Docker stack environment template.
#
# Copy to .env.docker and fill in real values:
#   cp .env.docker.example .env.docker
#
# .env.docker is gitignored on purpose: it carries live API keys.
# Values here are placeholders only; the stack will not answer questions until
# DASHSCOPE_API_KEY holds a real key.

# --- LLM / embedding provider ---------------------------------------------
DASHSCOPE_API_KEY=replace-me
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# Hybrid-reasoning models spend the completion budget on reasoning_content and
# can return an empty answer when this stays true.
LLM_ENABLE_THINKING=false
MODEL_FALLBACK_ENABLED=false
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# --- API keys --------------------------------------------------------------
# Both must be at least 32 characters and must differ from each other.
SERVICE_API_KEY=replace-me-with-32-plus-chars
ADMIN_API_KEY=replace-me-with-32-plus-chars-different

# --- Deployment ------------------------------------------------------------
IRA_DEPLOYMENT_ENVIRONMENT=local_staging
LOG_LEVEL=INFO
QA_LOCKED=true

# --- Vector backend --------------------------------------------------------
VECTOR_BACKEND=qdrant
QDRANT_COLLECTION_PREFIX=ira_qdrant
QDRANT_EXPECTED_MINOR=1.13
# QDRANT_URL is set by docker-compose to http://qdrant:6333; do not override here.
QDRANT_API_KEY=
# The knowledge base and generation to serve. Both are written by the
# ingestion flow; leave empty to let the active-generation pointer decide.
QDRANT_KB_ID=
QDRANT_GENERATION=

# --- Retrieval / QA --------------------------------------------------------
QA_TOP_K=12
QA_CHUNK_TOP_K=20
QA_REQUEST_TIMEOUT_SECONDS=180
QA_MAX_RETRIES=2
QA_SAFETY_POLICY_ENABLED=true
QA_OBSERVABILITY_ENABLED=true
QA_ANSWER_GROUNDING_ENABLED=true
QA_STRUCTURED_CITATION_OUTPUT_ENABLED=true
QA_RERANKER_ENABLED=false
QA_GROUNDING_AUDIT_ENABLED=false
RETRIEVAL_TRACE_TTL_SECONDS=86400
ENABLE_LLM_CACHE=true

# --- Optional parsers ------------------------------------------------------
MINERU_ENABLED=false
# --- Voice (speech input / spoken answers) ---------------------------------
# Off by default: ASR and TTS are billed per call.
IRA_VOICE_ENABLED=false
IRA_VOICE_ASR_MODEL=qwen3-asr-flash
IRA_VOICE_TTS_MODEL=qwen3-tts-flash
IRA_VOICE_TTS_VOICE=Cherry
IRA_VOICE_MAX_AUDIO_BYTES=5242880
IRA_VOICE_MAX_AUDIO_SECONDS=60
IRA_VOICE_TTS_MAX_CHARS=600
# Long answers are synthesized in sentence-aligned segments and stitched back
# into one WAV. This caps billed calls per request: 8 segments x 600 chars.
IRA_VOICE_TTS_MAX_SEGMENTS=8
# Upstream synthesis runs near real time: a full 600-char segment measured
# 88.7s. The first value caps one call, the second caps the whole request.
IRA_VOICE_TIMEOUT_SECONDS=120
IRA_VOICE_TTS_BUDGET_SECONDS=120
IRA_VOICE_RATE_LIMIT_PER_MINUTE=10
lightrag_data/
lightrag_storage*/
rag_storage/
vector_store/
graph_storage/

# Phase 3A parser experiment raw payloads (large binaries; kept on disk, not in git)
evaluation/experiments/parser_backend/P1/**/mineru_raw/
evaluation/mineru_smoke/
evaluation/experiments/parser_backend/fixed_model/cache/
evaluation/experiments/phase4/parent_expansion/cache/
evaluation/experiments/phase4/rerank/cache/
